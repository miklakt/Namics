lat : sphere : n_layers : 50
lat : sphere : lattice_type : hexagonal
lat : sphere : geometry : spherical
lat : sphere : gradients : 1
lat : sphere : FJC_choices : 5

mon : A : freedom : free
mon : B : freedom : free
mon : W : freedom : free
mon : A : chi_W : 2.0
mon : A : chi_A : 0.0
mon : B : chi_W : 0

mol : water : composition : (W)1
mol : water : freedom : solvent

mol : surf : composition : (B)100(A)100
mol : surf : freedom : restricted
mol : surf : n : 75

newton : isaac : e_info : false
newton : isaac : tolerance : 1e-08
newton : isaac : method : DIIS

sys : noname : initial_guess : file
sys : noname : guess_inputfile : output/micelle_guess_generate.json

output : json : append : false
json : mon : A : phi
json : mon : B : phi
json : mol : surf : phi
start
