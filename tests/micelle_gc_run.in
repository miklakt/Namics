//here is the file to perform search iterationm until the value of interes become zero
lat : sphere : n_layers : 50
lat : sphere : lattice_type : hexagonal
lat : sphere : geometry : spherical
lat : sphere : gradients : 1
lat : sphere : FJC_choices : 5

mon : A : freedom : free
mon : B : freedom : free
mon : W : freedom : free
mon : A : chi_W : 2.0
mon : A : chi_A : 0.0
mon : B : chi_W : 0

mol : water : composition : (W)1
mol : water : freedom : solvent

mol : surf : composition : (B)100(A)100
mol : surf : freedom : restricted
mol : surf : n : 50 //THIS IS WHAT WE ITERATE, LET US CALL IT X

newton : isaac : tolerance : 1e-08
newton : isaac : method : DIIS

output : json : append : false
json : mol : surf : n
json : mon : W : u //THIS EMMITS U-PROFILE FOR INITIAL GUESS
json : mon : B : u //THIS EMMITS U-PROFILE FOR INITIAL GUESS
json : mon : A : u //THIS EMMITS U-PROFILE FOR INITIAL GUESS
output : json : filename : run
json : sys : noname : grand_potential //THIS IS WHAT WE MEASURE
sys : noname : initial_guess : file
sys : noname : guess_inputfile : run.output.json //THIS PROPAGATE INITIAL GUESS

start
