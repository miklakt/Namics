lat : cyl : gradients : 2
lat : cyl : geometry : cylindrical
lat : cyl : lattice_type : hexagonal
lat : cyl : FJC_choices : 5
lat : cyl : n_layers_x : 8
lat : cyl : n_layers_y : 400
lat : cyl : lowerbound_y : surface

mon : WALL : freedom : frozen
mon : WALL : frozen_range : lowerbound_y

mon : X : freedom : pinned
mon : X : pinned_range : 1,1;8,1

mon : S : freedom : free
mon : B : freedom : free
mon : A : freedom : free
mon : T : freedom : free
mon : U : freedom : free
mon : W : freedom : free

mol : brush : composition : (X)1(S)298(B)1[(A)299(T)1][(A)299(T)1][(A)299(T)1](U)1
mol : brush : freedom : restricted
mol : brush : n : 4.272566004000002 // scaled to match the 1d x-averaged brush amount

mol : water : composition : (W)1
mol : water : freedom : solvent

newton : isaac : method : pseudohessian
newton : isaac : i_info : 20
newton : isaac : tolerance : 1e-8

output : json : append : false
json : mon : WALL : phi
