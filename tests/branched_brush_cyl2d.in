lat : cyl : gradients : 2
lat : cyl : geometry : cylindrical
lat : cyl : lattice_type : hexagonal
lat : cyl : FJC_choices : 5
lat : cyl : n_layers_x : 24
lat : cyl : n_layers_y : 120
lat : cyl : lowerbound_y : surface

mon : WALL : freedom : frozen
mon : WALL : frozen_range : lowerbound_y

mon : X : freedom : pinned
mon : X : pinned_range : 1,1;24,1

mon : S : freedom : free
mon : B : freedom : free
mon : A : freedom : free
mon : T : freedom : free
mon : U : freedom : free
mon : W : freedom : free

mol : brush : composition : (X)1(S)298(B)1[(A)299(T)1][(A)299(T)1][(A)299(T)1](U)1
mol : brush : freedom : restricted
mol : brush : theta : 30

mol : water : composition : (W)1
mol : water : freedom : solvent

newton : isaac : method : pseudohessian
newton : isaac : i_info : 20
newton : isaac : tolerance : 1e-6
newton : isaac : iterationlimit : 600
newton : isaac : deltamax : 0.1

output : json : append : false
json : mon : WALL : phi
json : mon : X : phi
json : mon : S : phi
json : mon : B : phi
json : mon : A : phi
json : mon : T : phi
json : mon : U : phi
json : mol : brush : phi
json : mol : water : phi

start
