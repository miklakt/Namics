// Brush grafted to the inner wall of a cylindrical pore (1 gradient, radial), from pore_poor_solvent.
// Identical to pore_poor_solvent/data/3752e9131bc34e5099669e31a6722f57.json (n_layers=20, N=300, n=2*pi*20*0.02, chi=1.5000000000000002),
// including the attractive wall chi_WALL used there.
lat : pore : gradients : 1
lat : pore : geometry : cylindrical
lat : pore : lattice_type : simple_cubic
lat : pore : n_layers : 20
lat : pore : lowerbound : mirror
lat : pore : upperbound : surface

mon : WALL : freedom : frozen
mon : WALL : frozen_range : upperbound
mon : X : freedom : pinned
mon : X : pinned_range : lastlayer
mon : X : chi_W : 1.5000000000000002
mon : X : chi_WALL : -2.181772661947858
mon : A : freedom : free
mon : A : chi_W : 1.5000000000000002
mon : A : chi_WALL : -2.181772661947858
mon : W : freedom : free

mol : brush : composition : (X)1(A)299
mol : brush : freedom : restricted
mol : brush : n : 2.5132741228718345
mol : water : composition : (W)1
mol : water : freedom : solvent

newton : isaac : method : pseudohessian
newton : isaac : tolerance : 1e-10

output : json : append : false
json : mon : X : phi
json : mol : brush : phi
json : mol : water : phi
