lat : flat : n_layers : 200
lat : flat : lattice_type : simple_cubic
lat : flat : geometry : planar
lat : flat : gradients : 1

mon : Si : freedom : frozen
mon : Si : frozen_range : 1;1
mon : A : freedom : free
mon : W : freedom : free
mon : A : chi_Si : 0

mol : water : composition : (W)1
mol : water : freedom : solvent

mol : pol : composition : (A)10000
mol : pol : freedom : free
mol : pol : phibulk : 1e-4

//for newer commits with json output
output : json : append : false
json : mol : pol : phi
json : mol : water : phi

//for older commits with pro output
//output : pro : append : false
//pro : mol : pol : phi
//pro : mol : water : phi

newton : isaac : deltamax : 0.1
newton : isaac : method : DIIS // other option is pseudohessian

start 
